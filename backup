#!/usr/bin/env bash

read -p "Путь к папке, которую архивируем? " way < /dev/tty

if [[ -z "$way" ]]; then
    way="$(pwd)"
fi

if [[ ! -d "$way" ]]; then
    echo "Ошибка: папка '$way' не найдена!"
    exit 1
fi

date="$(date +%Y-%m-%d)"
backup_name="backup_$date.tar.gz"

mkdir -p ~/backups

echo "Создаю архив: $backup_name"
tar -czf "$HOME/backups/$backup_name" -C "$way" . 2>/dev/null

if [[ $? -eq 0 ]]; then
    size=$(du -h "$HOME/backups/$backup_name" | cut -f1)   # ← ИСПРАВЛЕНО
    echo "Бэкап создан: ~/backups/$backup_name"
    echo "Размер: $size"
else
    echo "Ошибка создания бэкапа"
    exit 1
fi

old_files=$(find ~/backups -name "backup_*.tar.gz" -mtime +7 | wc -l)   # ← ИСПРАВЛЕНО
find ~/backups -name "backup_*.tar.gz" -mtime +7 -delete
echo "Удалено старых бэкапов: $old_files"
